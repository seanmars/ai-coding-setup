{
  "env": {
    "EDITOR": "code",
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js"
  },
  "outputStyle": "Explanatory",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Task(*)",
      "mcp__*",
      "Skill(*)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(del *)",
      "Bash(shutdown *)",
      "Bash(format *)",
      "Bash(reboot *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git rebase *)"
    ]
  }
}
