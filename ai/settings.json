{
  "env": {
    "EDITOR": "code",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "100",
    "MAX_THINKING_TOKENS": "20000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "language": "English",
  "autoUpdatesChannel": "latest",
  "effortLevel": "high",
  "advisorModel": "opus",
  "outputStyle": "Explanatory",
  "voiceEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Task(*)",
      "mcp__*",
      "Skill(*)",
      "Monitor(*)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(del *)",
      "Bash(shutdown *)",
      "Bash(format *)",
      "Bash(reboot *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git rebase *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js"
  }
}